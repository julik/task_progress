    @state: State

    # Starts from an empty tree
    # : () -> void
    def initialize: () -> void

    # One batch that lands a reader where the run of batches would have
    # : (Array[Batch]) -> Batch
    def squash: (Array[Batch]) -> Batch
  end
end
