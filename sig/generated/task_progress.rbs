  def root: () -> TaskProgress

  # The tasks directly under it, in the order they opened
  # : () -> Array[TaskProgress]
  def subtasks: () -> Array[TaskProgress]

  # Sends this task's subtree to an output, as a tree of its own rooted at `[]` - for the root
